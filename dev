#!/usr/bin/env bash

set -euo pipefail

repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
manifest_path="$repo_dir/manifest.json"
plugins_dir="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins"

fail() {
  echo "localhost-dev: $*" >&2
  exit 1
}

for dependency in inotifywait jq omarchy omarchy-shell rsync; do
  command -v "$dependency" >/dev/null 2>&1 || fail "missing required command: $dependency"
done

plugin_id="$(jq -er '.id | select(type == "string" and length > 0)' "$manifest_path")" ||
  fail "could not read the plugin id from $manifest_path"
target_dir="$plugins_dir/$plugin_id"
marker_path="$target_dir/.omarchy-localhost-dev"

omarchy plugin validate "$repo_dir"

mkdir -p "$plugins_dir"
if [[ (-e "$target_dir" || -L "$target_dir") && ! -f "$marker_path" ]]; then
  fail "$target_dir is an existing non-development install; remove it with 'omarchy plugin remove $plugin_id' first"
fi

mkdir -p "$target_dir"
touch "$marker_path"

sync_plugin() {
  sync_changes="$(rsync -a --delete --delete-excluded --out-format='%n' \
    --filter='protect /.omarchy-localhost-dev' \
    --exclude '/.*' \
    --exclude '__pycache__/' \
    --exclude '*.py[cod]' \
    "$repo_dir/" "$target_dir/")"
}

restart_shell() {
  # rescanPlugins recreates components at the same URLs. On shells that do
  # not clear the QML engine's component cache, that loads the previous code.
  omarchy restart shell || fail "could not restart omarchy-shell; the copied plugin may not be live"
}

sync_plugin
omarchy-shell shell ping >/dev/null ||
  fail "could not reach omarchy-shell; make sure the Omarchy shell is running"
restart_shell

plugin_enabled=""
for _attempt in {1..40}; do
  plugin_enabled="$(
    omarchy plugin list --json 2>/dev/null |
      jq -r --arg id "$plugin_id" '.[] | select(.id == $id) | .enabled | select(type == "boolean")'
  )" || true
  [[ -n "$plugin_enabled" ]] && break
  sleep 0.05
done
[[ -n "$plugin_enabled" ]] || fail "omarchy-shell did not discover $plugin_id"

if [[ "$plugin_enabled" != "true" ]]; then
  omarchy plugin enable "$plugin_id"
fi

echo "Watching $repo_dir"
echo "Live plugin: $target_dir"
echo "Save a file to sync it. QML, JavaScript, and manifest changes restart the shell to clear cached code."
echo "Press Ctrl+C to stop."

while IFS= read -r changed_path; do
  relative_path="${changed_path#"$repo_dir"/}"
  case "/$relative_path" in
    */.*|*/__pycache__/*|*/__pycache__) continue ;;
  esac
  # rsync already includes every saved change; wait for a burst to finish so
  # saving multiple files causes one restart rather than one per event.
  while IFS= read -r -t 0.2 _changed_path; do :; done
  sync_plugin
  while IFS= read -r synced_path; do
    case "$synced_path" in
      manifest.json|*.qml|*.js)
        restart_shell
        break
        ;;
    esac
  done <<< "$sync_changes"
  echo "Synced $relative_path"
done < <(
  inotifywait -r -q -m \
    -e close_write,create,delete,move \
    --exclude '(^|/)\.[^/]+(/|$)|(^|/)__pycache__(/|$)' \
    --format '%w%f' \
    "$repo_dir"
)
